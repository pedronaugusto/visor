{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig",
    "src/testing/spread.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "std",
        "visor"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ]
  ],
  "shipped": {
    "docs": "Pool identity and byte-domain API contracts needed by consumers of exported handles."
  },
  "glint": {
    "rules": [{"id": "P001", "level": "gate"}, {"id": "P003", "level": "gate"}, 
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      }
    ],
    "cast_scope": "all"
  },
  "glint_paths": [
    "src",
    "bench",
    "ci",
    "examples"
  ]
}
