{
  "compile_step": "check",
  "targets": [
    "x86_64-linux-gnu",
    "aarch64-linux-gnu",
    "x86_64-linux-musl",
    "x86_64-windows-gnu",
    "aarch64-windows-gnu",
    "x86_64-macos",
    "aarch64-macos"
  ],
  "compile_once": true,
  "jobs": [
    {
      "name": "ThreadSanitizer (Linux)",
      "step": "test",
      "args": ["-Dthread-sanitizer=true", "-Doptimize=debug", "-Dci-lint=false"],
      "tiers": ["release"]
    },
    {
      "name": "conformance",
      "step": "test",
      "directory": "conformance",
      "os": ["ubuntu-latest", "macos-latest"],
      "setup": false
    }
  ]
}
